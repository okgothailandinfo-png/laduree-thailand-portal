# Copy to .env and fill locally. Never commit real credentials.
#
# ============================================================================
# Environments (APP_ENV)
# ============================================================================
#   development — local prototype; mock providers allowed (default)
#   staging     — prototype/staging candidate; mock providers allowed when set
#   production  — fail-closed: prisma + external/oidc providers + HTTPS + secrets
#   test        — automated tests
#
# There is no separate "prototype" APP_ENV value. Staging (or local development)
# is the prototype/staging target. Use PAYMENT_PROVIDER=mock for all prototype demos.
#
# Prototype/staging MUST:
#   - use PAYMENT_PROVIDER=mock (never require a real Thailand PSP)
#   - never call a production payment provider
#   - support test orders + success/fail/cancel simulation
#   - keep DATA_SOURCE=mock for zero-infra local runs, OR prisma + local docker DB
#
# Provider kinds:
#   PAYMENT_PROVIDER / NOTIFICATION_* = mock | external
#   STORAGE_PROVIDER = local | external
#   ADMIN_AUTH_PROVIDER = mock | oidc
# external/oidc = integration boundary; register real vendor adapters before Go-Live.
# Do NOT hard-code a Thailand PSP vendor name.

NODE_ENV=development
APP_ENV=development
APP_NAME=laduree-thailand-pickup
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Data source
# ----------------------------------------------------------------------------
# DATABASE_URL may remain empty for local storefront work with DATA_SOURCE=mock.
# Sprint 26+: cart + gateway payments persist when DATA_SOURCE=prisma.
#
# Local docker-compose (optional — not required for mock prototype):
#   docker compose up -d
#   DATABASE_URL="postgresql://laduree:laduree@127.0.0.1:5432/laduree_pickup?schema=public"
#   REDIS_URL="redis://127.0.0.1:6379"
#   DATA_SOURCE=prisma
#   npm run prisma:generate && npm run db:deploy
#
# DATABASE_URL=
DATA_SOURCE=mock

# Media binary upload (development/staging local storage only — not for production)
STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_LOCAL_UPLOAD_DIR=public/uploads

# ----------------------------------------------------------------------------
# Payment (prototype default = mock)
# ----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# HMAC secret for POST /api/payment/webhook/mock (min 16 chars in staging/production when mock)
# Example local-only value (never use in production):
# MOCK_PAYMENT_WEBHOOK_SECRET=local-prototype-webhook-secret
MOCK_PAYMENT_WEBHOOK_SECRET=
MOCK_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Pickup credential reveal encryption (min 16 chars in staging/production)
# PICKUP_REVEAL_SECRET=local-prototype-pickup-secret
PICKUP_REVEAL_SECRET=

# Optional HMAC secret for customer order access tokens (falls back to PICKUP_REVEAL_SECRET)
# ORDER_ACCESS_SECRET=

# ----------------------------------------------------------------------------
# Notifications (mock for prototype)
# ----------------------------------------------------------------------------
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_LINE_PROVIDER=mock
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_PROCESS_LIMIT=20
NOTIFICATION_BASE_URL=http://localhost:3000
# NOTIFICATION_MOCK_FORCE_FAILURE=true

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
# development/staging: memory
# production: redis required (ioredis client wired via REDIS_URL)
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------------------
# Admin authentication (separate from customer/guest auth)
# ----------------------------------------------------------------------------
# development/staging: mock (isolated prototype mechanism)
# production: oidc + OIDC_* + ADMIN_SESSION_SECRET — no fake production auth
ADMIN_AUTH_PROVIDER=mock
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-app.example.com/api/admin/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# ADMIN_SESSION_SECRET=

# ----------------------------------------------------------------------------
# Staging / prototype candidate example (copy into a staging .env — not committed)
# ----------------------------------------------------------------------------
# APP_ENV=staging
# NODE_ENV=production
# APP_BASE_URL=https://staging.example.com
# DATA_SOURCE=mock
# PAYMENT_PROVIDER=mock
# MOCK_PAYMENT_WEBHOOK_SECRET=<min-16-char-non-placeholder-secret>
# PICKUP_REVEAL_SECRET=<min-16-char-non-placeholder-secret>
# NOTIFICATION_EMAIL_PROVIDER=mock
# NOTIFICATION_LINE_PROVIDER=mock
# STORAGE_PROVIDER=local
# ADMIN_AUTH_PROVIDER=mock
# RATE_LIMIT_STORE=memory

# ----------------------------------------------------------------------------
# Public Preview (Sprint 34) — PUBLIC WEBSITE LIVE / LIVE COMMERCE = NO
# Copy into the host environment. Canonical Public Preview domain: https://ok-go.cloud
# Do NOT set STOREFRONT_INDEXING=live. Do NOT set a production PSP.
# APP_ENV=preview is required. NODE_ENV=production without APP_ENV resolves to
# production (empty catalog + mock refused) and is the wrong public-preview mode.
# ----------------------------------------------------------------------------
# APP_ENV=preview
# NODE_ENV=production
# APP_BASE_URL=https://ok-go.cloud
# NOTIFICATION_BASE_URL=https://ok-go.cloud
# DATA_SOURCE=mock
# PAYMENT_PROVIDER=mock
# STORAGE_PROVIDER=local
# NOTIFICATION_EMAIL_PROVIDER=mock
# NOTIFICATION_LINE_PROVIDER=mock
# ADMIN_AUTH_PROVIDER=mock
# RATE_LIMIT_STORE=memory
# STOREFRONT_INDEXING=
# Optional. Preview-only test catalog (Napoléon 8pcs cart QA). Ignored unless APP_ENV=preview.
# Does not activate Production products or live commerce.
# PREVIEW_TEST_CATALOG=true
# MOCK_PAYMENT_WEBHOOK_SECRET=<min-16-char-integrity-secret-not-a-psp-key>
# PICKUP_REVEAL_SECRET=<min-16-char-integrity-secret>
# DATABASE_URL=
# REDIS_URL=
# OIDC_CLIENT_SECRET=
